-- The previous guard asked "is the signed-in user an admin?" from inside a
-- security-definer trigger. That check does not see the caller's session, so
-- every grant was written back to false. Authorization for editing someone
-- else's profile already lives on profiles_admin_update. This trigger only
-- stops a user from changing the flag on their own row.

drop policy if exists "profiles_admin_update" on public.profiles;
create policy "profiles_admin_update" on public.profiles
  for update
  using (
    exists (select 1 from public.profiles p where p.id = auth.uid() and p.is_admin = true)
  )
  with check (true);

create or replace function public.protect_admin_fields()
returns trigger
language plpgsql
security invoker
set search_path = public
as $$
begin
  if current_user in ('anon', 'authenticated')
     and auth.uid() is not distinct from old.id then
    new.is_admin := old.is_admin;
    new.is_suspended := old.is_suspended;
  end if;
  return new;
end;
$$;

drop trigger if exists protect_is_admin_trigger on public.profiles;
drop trigger if exists protect_admin_fields_trigger on public.profiles;
create trigger protect_admin_fields_trigger
before update on public.profiles
for each row execute function public.protect_admin_fields();
