-- ============ STORAGE BUCKETS (listing photos + avatars) ============
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('listing-photos', 'listing-photos', true, 10 * 1024 * 1024, array['image/jpeg','image/png','image/webp','image/gif']::text[])
on conflict (id) do nothing;

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('avatars', 'avatars', true, 5 * 1024 * 1024, array['image/jpeg','image/png','image/webp','image/gif']::text[])
on conflict (id) do nothing;

do $$
begin
  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='media_public_read') then
    execute $p$ create policy "media_public_read" on storage.objects for select to public using (bucket_id in ('listing-photos','avatars')) $p$;
  end if;

  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='listing_photos_owner_insert') then
    execute $p$ create policy "listing_photos_owner_insert" on storage.objects for insert to authenticated with check (bucket_id = 'listing-photos' and name like (auth.uid()::text || '/%')) $p$;
  end if;
  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='listing_photos_owner_update') then
    execute $p$ create policy "listing_photos_owner_update" on storage.objects for update to authenticated using (bucket_id = 'listing-photos' and name like (auth.uid()::text || '/%')) with check (bucket_id = 'listing-photos' and name like (auth.uid()::text || '/%')) $p$;
  end if;
  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='listing_photos_owner_delete') then
    execute $p$ create policy "listing_photos_owner_delete" on storage.objects for delete to authenticated using (bucket_id = 'listing-photos' and name like (auth.uid()::text || '/%')) $p$;
  end if;

  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='avatars_owner_insert') then
    execute $p$ create policy "avatars_owner_insert" on storage.objects for insert to authenticated with check (bucket_id = 'avatars' and name like (auth.uid()::text || '/%')) $p$;
  end if;
  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='avatars_owner_update') then
    execute $p$ create policy "avatars_owner_update" on storage.objects for update to authenticated using (bucket_id = 'avatars' and name like (auth.uid()::text || '/%')) with check (bucket_id = 'avatars' and name like (auth.uid()::text || '/%')) $p$;
  end if;
  if not exists (select 1 from pg_policies where schemaname='storage' and tablename='objects' and policyname='avatars_owner_delete') then
    execute $p$ create policy "avatars_owner_delete" on storage.objects for delete to authenticated using (bucket_id = 'avatars' and name like (auth.uid()::text || '/%')) $p$;
  end if;
end $$;