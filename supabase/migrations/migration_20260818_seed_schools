create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  incoming_school_id text;
begin
  incoming_school_id := nullif(btrim(coalesce(new.raw_user_meta_data->>'school_id', '')), '');
  if incoming_school_id is not null and not exists (
    select 1 from public.schools where id = incoming_school_id
  ) then
    incoming_school_id := null;
  end if;

  insert into public.profiles (id, full_name, avatar_url, school_id, bio, email)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'full_name', 'Student'),
    new.raw_user_meta_data->>'avatar_url',
    incoming_school_id,
    new.raw_user_meta_data->>'bio',
    new.email
  )
  on conflict (id) do update set
    full_name = coalesce(excluded.full_name, public.profiles.full_name),
    avatar_url = coalesce(excluded.avatar_url, public.profiles.avatar_url),
    school_id = coalesce(excluded.school_id, public.profiles.school_id),
    bio = coalesce(excluded.bio, public.profiles.bio),
    email = coalesce(excluded.email, public.profiles.email);

  insert into public.contact_details (user_id, phone, whatsapp)
  values (
    new.id,
    new.raw_user_meta_data->>'phone',
    new.raw_user_meta_data->>'whatsapp'
  )
  on conflict (user_id) do update set
    phone = coalesce(excluded.phone, public.contact_details.phone),
    whatsapp = coalesce(excluded.whatsapp, public.contact_details.whatsapp),
    updated_at = now();

  return new;
end;
$$;
